generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id         Int      @id @default(autoincrement())
  nombre     String
  industria  String
  pais       String
  ciudad     String
  inputJson  String
  resultJson String?
  pdfPath    String?
  createdAt  DateTime @default(now())
}